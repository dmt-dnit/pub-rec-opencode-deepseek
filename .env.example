# Copy to .env (gitignored) only if you need real Google OAuth login working locally.
# Nothing in this repo's build, tests, or the Order/Inventory saga requires these —
# auth-server falls back to the literal string "placeholder" if unset, and email/password
# login (the path every Track A task is built and tested against) never touches OAuth at all.

GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
