SERVER_PORT=9000
SPRING_H2_CONSOLE_ENABLED=false
# Override to enable H2 file-backed persistence on the VPS.
# When set, spring.datasource.url switches from in-memory (jdbc:h2:mem:authdb) to
# file-backed (jdbc:h2:file:/opt/pubrec/auth/data/authdb), surviving process restarts.
SPRING_DATASOURCE_URL=jdbc:h2:file:/opt/pubrec/auth/data/authdb
