[Unit]
Description=Pub-Rec Demo — auth-server
After=network.target

[Service]
Type=simple
User=pubrec
Group=pubrec
WorkingDirectory=/opt/pubrec/auth
EnvironmentFile=/etc/pubrec/auth.env
ExecStart=/usr/bin/java -Xms64m -Xmx160m -jar /opt/pubrec/auth/backend.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
