#!/bin/bash

set -o pipefail

if [ -z "$MAVEN_HOME" ]; then
  if [ -d "$HOME/.m2/wrapper/dists" ]; then
    MAVEN_USER_HOME="$HOME/.m2"
  fi
fi

if [ -n "$JAVA_HOME" ]; then
  JAVA_EXEC="$JAVA_HOME/bin/java"
else
  JAVA_EXEC="java"
fi

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
if [ -z "$MAVEN_USER_HOME" ]; then
  MAVEN_USER_HOME="$HOME/.m2"
fi

WRAPPER_LAUNCHER=".mvn/wrapper/maven-wrapper.jar"
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/$WRAPPER_LAUNCHER"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper..."
  WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$WRAPPER_URL" -o "$WRAPPER_JAR"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$WRAPPER_URL" -O "$WRAPPER_JAR"
  else
    echo "ERROR: Neither curl nor wget found. Cannot download Maven Wrapper." >&2
    exit 1
  fi
fi

MAVEN_OPTS="${MAVEN_OPTS:--Xmx512m}"

exec "$JAVA_EXEC" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" \
  -Dmaven.user.home="$MAVEN_USER_HOME" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
