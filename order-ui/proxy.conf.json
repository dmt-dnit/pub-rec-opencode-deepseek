{
  "/api/auth/**": {
    "target": "http://localhost:9000",
    "secure": false,
    "logLevel": "debug"
  },
  "/oauth2/**": {
    "target": "http://localhost:9000",
    "secure": false,
    "logLevel": "debug"
  },
  "/login/oauth2/**": {
    "target": "http://localhost:9000",
    "secure": false,
    "logLevel": "debug"
  },
  "/api/orders/**": {
    "target": "http://localhost:8080",
    "secure": false,
    "logLevel": "debug"
  },
  "/ws/**": {
    "target": "http://localhost:8080",
    "secure": false,
    "ws": true,
    "logLevel": "debug"
  }
}
